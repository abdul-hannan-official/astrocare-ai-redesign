# GEMINI_API_KEY: Optional server-side key for Gemini AI Health Assistant enrichment.
# AI Studio automatically injects this at runtime from user secrets.
# If omitted, ASTROCARE AI transparently uses its deterministic reading-grounded engine.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# PORT: Server port (defaults to 3000)
PORT=3000

# DATABASE_PATH: SQLite database file path (defaults to ./data/astrocare.db)
DATABASE_PATH="./data/astrocare.db"
